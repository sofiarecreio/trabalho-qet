<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.bhlangonijr.chesslib</groupId>
    <artifactId>chesslib</artifactId>
    <version>1.3.7</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.1</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <plugin>  <!-- Create sources.jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <source>8</source>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <includes>
                        <include>com/github/bhlangonijr/chesslib/move/MoveGenerator*</include>
                    </includes>
                    <excludes>
                        <exclude>com/github/bhlangonijr/chesslib/move/MoveGeneratorException</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.github.bhlangonijr.chesslib.move.MoveGenerator*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.17.4</version>
                <configuration>
                    <targetClasses>
                        <param>com.github.bhlangonijr.chesslib.move.MoveGenerator</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.github.bhlangonijr.chesslib.move.LucasMoveGeneratorTest</param>
                        <param>com.github.bhlangonijr.chesslib.move.MoveGeneratorTest</param>
                    </targetTests>
                    <mutationThreshold>80</mutationThreshold>
                    <timestampedReports>false</timestampedReports>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                        <param>CSV</param>
                    </outputFormats>
                    <threads>1</threads>
                    <timeoutConstant>10000</timeoutConstant>
                    <failWhenNoMutations>true</failWhenNoMutations>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>movelist-quality</id>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>

                        <configuration>
                            <includes combine.self="override">
                                <include>com/github/bhlangonijr/chesslib/move/MoveList.class</include>
                            </includes>

                            <destFile>${project.build.directory}/jacoco-movelist.exec</destFile>
                            <dataFile>${project.build.directory}/jacoco-movelist.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-movelist</outputDirectory>
                            <append>false</append>
                        </configuration>

                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <configuration>
                                    <includes combine.self="override">
                                        <include>com/github/bhlangonijr/chesslib/move/MoveList</include>
                                    </includes>
                                </configuration>
                            </execution>

                            <execution>
                                <id>check</id>
                                <configuration>
                                    <rules combine.self="override">
                                        <rule>
                                            <element>CLASS</element>

                                            <includes>
                                                <include>com.github.bhlangonijr.chesslib.move.MoveList</include>
                                            </includes>

                                            <limits>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.80</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>

                        <configuration>
                            <targetClasses combine.self="override">
                                <param>com.github.bhlangonijr.chesslib.move.MoveList</param>
                            </targetClasses>

                            <targetTests combine.self="override">
                                <param>com.github.bhlangonijr.chesslib.move.MoveListTest</param>
                                <param>com.github.bhlangonijr.chesslib.move.MoveListQetTest</param>
                            </targetTests>

                            <reportsDirectory>${project.build.directory}/pit-reports-movelist</reportsDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>game-quality</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <configuration>
                            <includes combine.self="override">
                                <include>com/github/bhlangonijr/chesslib/game/Game.class</include>
                            </includes>
                            <destFile>${project.build.directory}/jacoco-game.exec</destFile>
                            <dataFile>${project.build.directory}/jacoco-game.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-game</outputDirectory>
                            <append>false</append>
                        </configuration>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <configuration>
                                    <includes combine.self="override">
                                        <include>com/github/bhlangonijr/chesslib/game/Game</include>
                                    </includes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>check</id>
                                <configuration>
                                    <rules combine.self="override">
                                        <rule>
                                            <element>CLASS</element>
                                            <includes>
                                                <include>com.github.bhlangonijr.chesslib.game.Game</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.80</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>com.github.bhlangonijr.chesslib.game.Game</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>com.github.bhlangonijr.chesslib.game.Game*Test</param>
                            </targetTests>
                            <reportsDirectory>${project.build.directory}/pit-reports-game</reportsDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
